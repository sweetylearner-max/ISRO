# ExoSeer backend configuration. Copy to .env and edit as needed.
# The app is fully functional with all of these unset (demo-safe defaults).

# Where downloaded light curves are cached.
EXOSEER_CACHE_DIR=./cache

# CORS: comma-separated allowed origins (or "*" for a public demo backend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LLM narrative enhancement. Default "none" -> deterministic templated text.
# Providers: none | groq | gemini | hf | anthropic
EXOSEER_LLM_PROVIDER=none
EXOSEER_LLM_KEY=
EXOSEER_LLM_MODEL=

# Pipeline tunables.
EXOSEER_SDE_THRESHOLD=7.0
EXOSEER_PERIOD_MIN=0.5
EXOSEER_PERIOD_MAX=50.0
